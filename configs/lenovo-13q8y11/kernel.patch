@@ -17,7 +17,11 @@
 
 / {
 	model = "Qualcomm Technologies, Inc. Kalambo CRD";
-	compatible = "qcom,kalambo-crd", "qcom,kalambo";
+	/*
+	 * "qcom,mahua" fallback: ubwc_config (msm-mdss), qcom_pd_mapper and
+	 * memlat devfreq only match on the mahua/glymur machine compatible.
+	 */
+	compatible = "qcom,kalambo-crd", "qcom,kalambo", "qcom,mahua";
 };
 
 &tcsr {
@@ -34,4 +38,80 @@ &tcsr {
 	vdda-qreftx1-0p9-supply = <&vreg_l1f_e1_0p82>;
 	vdda-refgen3-0p9-supply = <&vreg_l1f_e1_0p82>;
 	vdda-refgen3-1p2-supply = <&vreg_l4f_e1_1p08>;
-};
\ No newline at end of file
+};
+/*
+ * Lenovo laptop display: 1920x1200 eDP LCD with PMIC PWM backlight
+ * (DSDT: BacklightType 1, PMIC PWM 12-bit @ 2400 Hz), not the CRD's
+ * Samsung ATNA OLED with DPCD AUX backlight.
+ */
+/ {
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		/* 2.4 kHz; LPG channel 3 is a guess (unverified from DSDT) */
+		pwms = <&pmh0101_pwm 3 416666>;
+	};
+};
+
+&pmh0101_pwm {
+	status = "okay";
+};
+
+&mdss_dp3 {
+	pinctrl-0 = <&edp_hpd_default>;
+	pinctrl-names = "default";
+
+	aux-bus {
+		panel {
+			compatible = "edp-panel";
+			backlight = <&backlight>;
+		};
+	};
+};
+
+&tlmm {
+	/* DSDT GPU0 power sequence muxes gpio119 to function 1 (edp0_hot) */
+	edp_hpd_default: edp-hpd-default-state {
+		pins = "gpio119";
+		function = "edp0_hot";
+		bias-disable;
+	};
+};
+
+/*
+ * Match the voltages Windows votes for \_SB.GPU0 in the DSDT (PEP G0MC):
+ *   LDO2_F_E1  880 mV  (eDP PHY vdda-phy; CRD DT has 832 mV)
+ *   LDO18_B_E0 1.2 V   (required by the display, off on Linux)
+ */
+&vreg_l2f_e1_0p83 {
+	regulator-min-microvolt = <880000>;
+	regulator-max-microvolt = <880000>;
+};
+
+&vreg_l18b_e0_1p2 {
+	regulator-always-on;
+};
+
+/*
+ * Lenovo touchpad: ELAN06FA (DSDT \_SB.TPD3, enabled by TPDC = 0x04F3)
+ * on \_SB.I2C1 (= i2c0) at 0x15, HID descriptor at 0x01, IRQ on GPIO 3.
+ * The CRD's touchpad@2c with descriptor 0x20 does not exist here.
+ */
+&i2c0 {
+	/delete-node/ touchpad@2c;
+
+	touchpad@15 {
+		compatible = "hid-over-i2c";
+		reg = <0x15>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_misc_3p3>;
+		vddl-supply = <&vreg_l15b_e0_1p8>;
+
+		pinctrl-0 = <&tpad_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+};
